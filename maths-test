<script>
"use strict";
const get = id => document.getElementById(id);
const a = Math.sqrt(Math.PI);
const scale3D = 110, crossScale = 85;
let mode = 1, height = 0.5, playing = false, direction = 1, lastTimestamp = null;
function project(p) { return [520 + scale3D * (p[0] + 0.5 * p[1]), 330 - scale3D * (p[2] + 0.32 * p[1])]; }
function points(vertices) { return vertices.map(v => v.join(",")).join(" "); }
function polygon(vertices, fill, opacity = 1, stroke = "#52677d") {
  return `<polygon points="${points(vertices)}" fill="${fill}" fill-opacity="${opacity}" stroke="${stroke}" stroke-width="1.6"/>`;
}
function edge(p, q, dashed = false, color = "#52677d") {
  return `<path d="M${p.join(",")} L${q.join(",")}" fill="none" stroke="${color}" stroke-width="1.5"${dashed ? ' stroke-dasharray="5 4"' : ""}/>`;
}
function label(p, text, dx = 5, dy = -6) {
  const content = text.replace(/([A-Z])1/g, '$1<tspan baseline-shift="sub" font-size="12">1</tspan>');
  return `<text x="${p[0] + dx}" y="${p[1] + dy}">${content}</text>`;
}
function cubeSection(t) {
  return [[0,a,t],[0,0,t],[a*(1-t),0,t],[a*(1-t),a*t,t],[a,a*t,t],[a,a,t]];
}
function removedSection(t) { return [[a*(1-t),0,t],[a,0,t],[a,a*t,t],[a*(1-t),a*t,t]]; }
function prismSection(t) { return [[0,0,t],[a*(1-t),0,t],[a*(1-t),a,t],[0,a,t]]; }
function ballMarkup(part, t) {
  const cx = 200, cy = 300, r = scale3D;
  const radial = Math.sqrt(Math.max(0, part === 1 ? 1 - t*t : 1 - t));
  const outline = part === 1 ?
    `M${cx-r},${cy} A${r},${r} 0 0 1 ${cx+r},${cy} A${r},${r*0.26} 0 0 1 ${cx-r},${cy}` :
    `M${cx-r},${cy} Q${cx-r/2},${cy-r} ${cx},${cy-r} Q${cx+r/2},${cy-r} ${cx+r},${cy} A${r},${r*0.26} 0 0 1 ${cx-r},${cy}`;
  let result = `<path d="${outline}" fill="#edf6ff" stroke="#52677d" stroke-width="2"/>`;
  result += `<ellipse cx="${cx}" cy="${cy}" rx="${r}" ry="${r*0.26}" fill="none" stroke="#899caf" stroke-dasharray="5 4"/>`;
  for (const h of [0.2,0.4,0.6,0.8]) {
    const rr = r*Math.sqrt(part===1 ? 1-h*h : 1-h);
    result += `<ellipse cx="${cx}" cy="${cy-r*h}" rx="${rr}" ry="${rr*0.26}" fill="none" stroke="#c1d4e4" stroke-width="1"/>`;
  }
  result += `<ellipse cx="${cx}" cy="${cy-r*t}" rx="${r*radial}" ry="${r*radial*0.26}" fill="#49a0df" fill-opacity="0.6" stroke="#1769aa" stroke-width="2"/>`;
  if (radial === 0) result += `<circle cx="${cx}" cy="${cy-r}" r="3" fill="#1769aa"/>`;
  result += edge([cx,cy-r*t],[cx+r*radial,cy-r*t],false,"#1769aa");
  result += label([cx+r*radial/2,cy-r*t],"r",3,-8);
  result += edge([60,cy],[60,cy-r*t]);
  result += label([60,cy-r*t/2],part===1 ? "d" : "t",-25,0);
  result += edge([350,cy],[350,cy-r]);
  result += label([350,cy-r/2],part===1 ? "R" : "1",7,0);
  result += label([cx,cy],part===1 ? "O" : "y = 0",-6,32);
  result += label([cx,cy-r*t],part===1 ? "O1" : "y = t",-37,-9);
  result += `<text x="${cx}" y="65" text-anchor="middle" style="font-size:22px">${part===1 ? "半球" : "抛物线旋转体"}</text>`;
  return result;
}
function cubeMarkup(t) {
  const v = [[0,0,0],[a,0,0],[a,a,0],[0,a,0],[0,0,1],[a,0,1],[a,a,1],[0,a,1]].map(project);
  let result = polygon([v[0],v[1],v[5],v[4]],"#eef1f5",0.6) + polygon([v[1],v[2],v[6],v[5]],"#eef1f5",0.5);
  result += polygon([v[1],v[4],v[7]],"#efab56",0.13,"#bd8744") + polygon([v[1],v[7],v[6]],"#efab56",0.10,"#bd8744");
  for (const [i,j] of [[0,1],[1,2],[2,3],[3,0],[4,5],[5,6],[6,7],[7,4],[0,4],[1,5],[2,6],[3,7]]) result += edge(v[i],v[j],[[2,3],[3,0],[3,7]].some(p=>p[0]===i&&p[1]===j));
  for (const i of [4,5,6,7]) result += edge(v[1],v[i],true,"#bd8744");
  result += polygon(removedSection(t).map(project),"#f5ba70",0.6,"#bd8744");
  result += polygon(cubeSection(t).map(project),"#49a0df",0.6,"#1769aa");
  const names = ["A","B","C","D","A1","B1","C1","D1"];
  names.forEach((name,i)=>{ result += label(v[i],name,i===3 ? -30 : -8,i<4 ? 22 : -8); });
  cubeSection(t).map(project).forEach((p,i)=>{ result += label(p,["I","J","E","K","G","H"][i],i===3 ? -15 : 5,i===2 ? 19 : -7); });
  result += `<text x="710" y="65" text-anchor="middle" style="font-size:22px">正四棱柱减去倒四棱锥</text><text x="710" y="100" text-anchor="middle">锥顶在B；保留截面为L形</text>`;
  result += label(project([a,0,0.5]),"高 R",25,0);
  return result;
}
function prismMarkup(t) {
  const v = [[0,0,0],[a,0,0],[0,0,1],[0,a,0],[a,a,0],[0,a,1]].map(project);
  let result = polygon([v[0],v[2],v[5],v[3]],"#eef1f5",0.6) +
    polygon([v[1],v[2],v[5],v[4]],"#dce8f2",0.4) +
    polygon([v[0],v[1],v[2]],"#edf3f8",0.4);
  for (const [i,j] of [[0,1],[1,2],[2,0],[3,4],[4,5],[5,3],[0,3],[1,4],[2,5]]) result += edge(v[i],v[j],[[3,4],[5,3],[0,3]].some(p=>p[0]===i&&p[1]===j));
  result += polygon(prismSection(t).map(project),"#49a0df",0.6,"#1769aa");
  if (t===1) result += edge(v[2],v[5],false,"#1769aa");
  ["A","B","C","A′","B′","C′"].forEach((name,i)=>{result += label(v[i],name,i===3 ? -50 : -8,i===3 ? 0 : i===0||i===1||i===4 ? 22 : -8);});
  prismSection(t).map(project).forEach((p,i)=>{result += label(p,["P","Q","S","T"][i],i===3 ? -18 : 5,i===1 ? 20 : -7);});
  result += `<text x="710" y="65" text-anchor="middle" style="font-size:22px">单个侧放的直三棱柱</text><text x="710" y="100" text-anchor="middle">三角形底面竖直；截面PQST是矩形</text>`;
  result += label(project([a/2,0,0]),"√π",-15,45) + label(project([0,a/2,0]),"√π",-45,15) + label(project([0,0,0.5]),"1",-24,0);
  return result;
}
function drawScene(id,part,t) {
  const legend = part===1 ?
    "蓝色：保留的同高截面　橙色：被挖去部分　立体图为示意投影" :
    "蓝色：同高截面（圆与矩形）　比较两个完整几何体　立体图为示意投影";
  get(id).innerHTML = ballMarkup(part,t) + (part===1 ? cubeMarkup(t) : prismMarkup(t)) +
    `<text x="500" y="406" text-anchor="middle" style="font-size:16px">${legend}</text>`;
}
function drawGraph() {
  get("cleanGraph").innerHTML =
    '<path d="M110,300 L110,120 Q200,120 290,300 Z" fill="#b9daf3" fill-opacity="0.65"/>' +
    '<path d="M110,120 Q200,120 290,300" stroke="#1769aa" stroke-width="2.5" fill="none"/>' +
    '<path d="M85,300 H335 M110,325 V88" stroke="#203044" stroke-width="2"/>' +
    '<path d="M335,300 l-10,-5 m10,5 l-10,5 M110,88 l-5,10 m5,-10 l5,10" stroke="#203044" stroke-width="1.5" fill="none"/>' +
    '<text x="96" y="321">O</text><text x="344" y="307">x</text><text x="102" y="78">y</text><text x="89" y="127">1</text><text x="286" y="324">1</text>' +
    '<text x="171" y="151">y = 1 − x²</text><text x="442" y="223">绕y轴旋转一周 →</text>' +
    '<g transform="translate(570,-25) scale(0.8)">' + ballMarkup(2,0.5) + '</g>';
}
function drawCrossSections(part,t) {
  const radius = crossScale*Math.sqrt(Math.max(0,part===1 ? 1-t*t : 1-t));
  const convert = p => [600+crossScale*p[0],245-crossScale*p[1]];
  let right;
  if (part===1) {
    right = polygon([[0,a],[0,0],[a,0],[a,a]].map(convert),"#fff8ec",1,"#bd8744");
    right += polygon(removedSection(t).map(p=>convert(p)),"#f5ba70",0.7,"#bd8744");
    right += polygon(cubeSection(t).map(p=>convert(p)),"#49a0df",0.65,"#1769aa").replace("<polygon ","<polygon id=\"crossComparison\" ");
  } else {
    const p = prismSection(t).map(convert);
    right = polygon(p,"#49a0df",0.65,"#1769aa").replace("<polygon ","<polygon id=\"crossComparison\" ");
  }
  get("scanCrossSections").innerHTML =
    `<text x="220" y="43" text-anchor="middle">圆截面</text><text x="700" y="43" text-anchor="middle">${part===1 ? "L形保留截面（橙色挖去）" : "单个直三棱柱的矩形截面"}</text>` +
    `<circle id="crossCircle" cx="220" cy="170" r="${radius}" fill="#49a0df" fill-opacity="0.65" stroke="#1769aa" stroke-width="1.6"/>` +
    (radius===0 ? '<circle cx="220" cy="170" r="3" fill="#1769aa"/><text x="234" y="176">点，面积0</text>' : "") + right +
    `<text x="500" y="295" text-anchor="middle">左右图采用相同长度比例；比较的是面积，不是形状</text>`;
}
function setPlaying(value) {
  playing=value; lastTimestamp=null; get("scanPlay").textContent=value ? "暂停" : "播放扫描";
}
function render() {
  const radial = Math.sqrt(Math.max(0,mode===1 ? 1-height*height : 1-height));
  const leftArea = Math.PI*radial*radial;
  const rightArea = mode===1 ? a*a-(a*height)*(a*height) : (a*(1-height))*a;
  drawScene("scanScene",mode,height); drawCrossSections(mode,height);
  get("scanHeight").value=String(height); get("heightValue").textContent=height.toFixed(3);
  get("heightLabel").textContent=mode===1 ? "高度比 d/R" : "截面高度 y = t";
  get("modeOne").setAttribute("aria-pressed",String(mode===1)); get("modeTwo").setAttribute("aria-pressed",String(mode===2));
  for (const [name,h] of [["Bottom",0],["Middle",0.5],["Top",1]]) get("stage"+name).setAttribute("aria-pressed",String(Math.abs(height-h)<1e-9));
  get("circleArea").textContent=leftArea.toFixed(4);
  get("comparisonArea").textContent=rightArea.toFixed(4);
  get("areaDifference").textContent=(leftArea-rightArea).toFixed(4).replace("-0.0000","0.0000");
  get("equalStatus").textContent="同一高度，圆截面积 = 比较截面积；扫描整个高度区间都成立。";
  get("scanScene").dataset.mode=String(mode); get("scanScene").dataset.height=String(height);
  get("scanScene").dataset.circleArea=String(leftArea); get("scanScene").dataset.comparisonArea=String(rightArea);
  get("scanTitle").textContent=height===0 ? "底面：两截面积相同" : height===1 ? "顶端：形状退化，面积均为0" : mode===1 ? "这一层：圆与L形等面积" : "这一层：圆与矩形等面积";
  get("scanExplanation").textContent=mode===1 ?
    "半球圆半径的平方为R²−d²。倒锥截面长度比为d/R，面积比为其平方；外正方形减去角部小正方形，得到同样的面积。动画取R = 1。" :
    "旋转体圆半径的平方为1−t。侧放三棱柱的矩形一条边为√π(1−t)，另一条边恒为√π，乘积就是π(1−t)。顶端一个是点、一个是线段，面积都为0。";
  get("scanFormula").innerHTML=mode===1 ?
    '<math display="block"><msub><mi>S</mi><mn>1</mn></msub><mo>=</mo><mi>π</mi><mo>(</mo><msup><mi>R</mi><mn>2</mn></msup><mo>−</mo><msup><mi>d</mi><mn>2</mn></msup><mo>)</mo></math><math display="block"><msub><mi>S</mi><mn>2</mn></msub><mo>=</mo><mi>π</mi><msup><mi>R</mi><mn>2</mn></msup><mo>−</mo><mi>π</mi><msup><mi>d</mi><mn>2</mn></msup><mo>=</mo><msub><mi>S</mi><mn>1</mn></msub></math>' :
    '<math display="block"><msub><mi>S</mi><mtext>圆</mtext></msub><mo>=</mo><mi>π</mi><mo>(</mo><mn>1</mn><mo>−</mo><mi>t</mi><mo>)</mo></math><math display="block"><msub><mi>S</mi><mtext>矩形</mtext></msub><mo>=</mo><msqrt><mi>π</mi></msqrt><mo>(</mo><mn>1</mn><mo>−</mo><mi>t</mi><mo>)</mo><mo>·</mo><msqrt><mi>π</mi></msqrt><mo>=</mo><msub><mi>S</mi><mtext>圆</mtext></msub></math>';
}
function chooseHeight(value) { setPlaying(false); height=value; direction=value===1 ? -1 : 1; render(); }
get("modeOne").addEventListener("click",()=>{mode=1;chooseHeight(0.5);});
get("modeTwo").addEventListener("click",()=>{mode=2;chooseHeight(0.5);});
get("stageBottom").addEventListener("click",()=>chooseHeight(0));
get("stageMiddle").addEventListener("click",()=>chooseHeight(0.5));
get("stageTop").addEventListener("click",()=>chooseHeight(1));
get("scanHeight").addEventListener("input",()=>chooseHeight(Number(get("scanHeight").value)));
get("scanReset").addEventListener("click",()=>chooseHeight(0));
get("scanPlay").addEventListener("click",()=>setPlaying(!playing));
document.addEventListener("visibilitychange",()=>{lastTimestamp=null;});
function tick(timestamp) {
  if (playing&&!document.hidden) {
    if (lastTimestamp!==null) {
      height+=Math.min((timestamp-lastTimestamp)/1000,0.1)*0.18*Number(get("scanSpeed").value)*direction;
      if(height>=1){height=1;direction=-1;} else if(height<=0){height=0;direction=1;}
      render();
    }
    lastTimestamp=timestamp;
  }
  requestAnimationFrame(tick);
}
drawScene("cleanScene1",1,0.45); drawGraph(); drawScene("constructedPrism",2,0.5);
render(); requestAnimationFrame(tick);
</script>
</body>
</html>
